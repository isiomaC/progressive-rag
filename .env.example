# Copy to .env and fill in to switch from offline demo mode to real LLMs.
# Everything runs without this file (extractive/offline mode).
#
# Two first-class providers are supported (both OpenAI-compatible HTTP APIs):
#   --llm openai    (gpt-4o-mini by default)
#   --llm deepseek  (deepseek-chat by default)
# The same experiment suite runs against either, so numbers are comparable.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Local embedding / reranker models (sentence-transformers) ---
# Leave EMBED_MODEL empty to use local embeddings; set to "openai" to use
# OpenAI embeddings instead (requires OPENAI_API_KEY).
EMBED_MODEL=
EMBED_MODEL_NAME=all-MiniLM-L6-v2
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
